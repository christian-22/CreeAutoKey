<Window x:Class="InputAutomator.Views.MiniStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input Automator"
        Width="220" Height="120"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="ToolWindow"
        Background="#1E1E2E">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- State -->
        <TextBlock x:Name="StateText"
                   Grid.Row="0"
                   Text="OFF"
                   FontSize="36" FontWeight="Bold"
                   Foreground="#A6ADC8"
                   HorizontalAlignment="Center"/>

        <!-- Hotkey info -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center">
            <TextBlock x:Name="ToggleInfo"
                       Text="Toggle: Ctrl+Shift+T"
                       FontSize="10" Foreground="#6C7086"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Stop: Esc │ Ctrl+Alt+End"
                       FontSize="10" Foreground="#6C7086"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
