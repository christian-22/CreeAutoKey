<Window x:Class="InputAutomator.Views.DeveloperModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Developer Mode"
        Width="520" Height="460"
        Background="#1E1E2E"
        WindowStyle="ToolWindow">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- State + Held Inputs -->
        <GroupBox Grid.Row="0" Header="Current State" Foreground="#CDD6F4" BorderBrush="#45475A" Margin="0,0,0,6">
            <StackPanel Margin="4">
                <TextBlock x:Name="DevState" Text="State: Idle" Foreground="#A6ADC8" FontSize="14" FontWeight="Bold"/>
                <TextBlock x:Name="DevHeldKeys" Text="Held keys: (none)" Foreground="#A6ADC8" FontSize="12" Margin="0,4,0,0"/>
                <TextBlock x:Name="DevHeldMouse" Text="Held mouse: (none)" Foreground="#A6ADC8" FontSize="12"/>
            </StackPanel>
        </GroupBox>

        <!-- Config snapshot -->
        <GroupBox Grid.Row="1" Header="Configuration" Foreground="#CDD6F4" BorderBrush="#45475A" Margin="0,0,0,6">
            <TextBlock x:Name="DevConfig" Text="..." Foreground="#A6ADC8" FontSize="11" TextWrapping="Wrap" Margin="4"/>
        </GroupBox>

        <!-- Clear button -->
        <Button Grid.Row="2" Content="Clear Log" Click="ClearLog_Click"
                HorizontalAlignment="Left" Padding="10,3" Margin="0,0,0,6"
                Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A"/>

        <!-- Log stream -->
        <ListBox Grid.Row="3"
                 x:Name="LogList"
                 Background="#181825" Foreground="#A6ADC8"
                 BorderBrush="#45475A"
                 FontFamily="Consolas" FontSize="11"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
    </Grid>
</Window>
