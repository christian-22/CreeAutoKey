<Window x:Class="InputAutomator.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input Automator — Config"
        Width="440" Height="580"
        Background="#1E1E2E"
        Closing="Window_Closing">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A6ADC8"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#181825"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="MaxHeight" Value="90"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#A6ADC8"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">

            <!-- Toggle Hotkey -->
            <GroupBox Header="Toggle Hotkey">
                <StackPanel Margin="4">
                    <TextBlock Text="Click the box below and press your desired hotkey combo:" FontSize="11"/>
                    <TextBox x:Name="HotkeyBox" IsReadOnly="True" Text="Ctrl+Shift+T"
                             PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                             GotFocus="HotkeyBox_GotFocus"
                             LostFocus="HotkeyBox_LostFocus"
                             FontSize="14" FontWeight="Bold"
                             Margin="0,4,0,4" TextAlignment="Center"/>
                    <TextBlock x:Name="HotkeyStatus" Text="" FontSize="10" Foreground="#F38BA8"/>
                </StackPanel>
            </GroupBox>

            <!-- Hold Bindings -->
            <GroupBox Header="Hold Bindings (stay pressed)">
                <StackPanel Margin="4">
                    <ListBox x:Name="HoldList"/>
                    <WrapPanel Margin="0,4,0,0">
                        <Button Content="+ Capture Key" Click="AddHoldKey_Click"/>
                        <Button Content="+ Left Click" Click="AddHoldMouseLeft_Click"/>
                        <Button Content="+ Right Click" Click="AddHoldMouseRight_Click"/>
                        <Button Content="+ Middle Click" Click="AddHoldMouseMiddle_Click"/>
                        <Button Content="Remove Selected" Click="RemoveHold_Click"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

            <!-- Repeat Bindings -->
            <GroupBox Header="Repeat Bindings (click at interval)">
                <StackPanel Margin="4">
                    <ListBox x:Name="RepeatList"/>
                    <WrapPanel Margin="0,4,0,0">
                        <Button Content="+ Capture Key" Click="AddRepeatKey_Click"/>
                        <Button Content="+ Left Click" Click="AddRepeatMouseLeft_Click"/>
                        <Button Content="+ Right Click" Click="AddRepeatMouseRight_Click"/>
                        <Button Content="+ Middle Click" Click="AddRepeatMouseMiddle_Click"/>
                        <Button Content="Remove Selected" Click="RemoveRepeat_Click"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

            <!-- Interval -->
            <GroupBox Header="Repeat Interval">
                <StackPanel Margin="4">
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="IntervalBox" Text="1.0" Width="80" TextChanged="IntervalBox_TextChanged"/>
                        <TextBlock Text=" seconds" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <CheckBox x:Name="HumanizeCheck" Content="Humanize (random jitter ±"
                                  Checked="Humanize_Changed" Unchecked="Humanize_Changed"/>
                        <TextBox x:Name="JitterBox" Text="0.05" Width="50"
                                 TextChanged="JitterBox_TextChanged"/>
                        <TextBlock Text="s)" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Controls -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                <Button x:Name="ToggleBtn" Content="Toggle ON/OFF" Click="ToggleBtn_Click"
                        FontSize="14" Padding="16,6"/>
                <Button Content="Developer Mode" Click="DevMode_Click" Padding="16,6"/>
            </StackPanel>

            <!-- Safety info -->
            <TextBlock Text="Hard stops: Esc, Ctrl+Alt+End (always work when automation is active)"
                       FontSize="10" Foreground="#6C7086" HorizontalAlignment="Center" Margin="0,8,0,0"
                       TextWrapping="Wrap" TextAlignment="Center"/>
            <TextBlock Text="Ctrl+Alt+Delete is a system bailout (not capturable by apps)"
                       FontSize="10" Foreground="#585B70" HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>
    </ScrollViewer>
</Window>
